POSTGRES_DB=referee_db
POSTGRES_USER=referee_user
POSTGRES_PASSWORD=replace-with-a-strong-password

DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=0
# 以逗号分隔，填写访问网站时使用的主机名或 IP
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_HTTPS_ENABLED=0
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_SECURE_HSTS_PRELOAD=0
# Docker 构建代理，不需要时留空
BUILD_HTTP_PROXY=
BUILD_HTTPS_PROXY=

# 邮件通知（可选）。不设置 EMAIL_HOST 时只发站内通知。
# QQ 邮箱：smtp.qq.com，163 邮箱：smtp.163.com；密码填 SMTP 授权码，不是登录密码。
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USE_SSL=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
